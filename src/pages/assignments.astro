---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '@/components/starwind/table';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import { Button } from '@/components/starwind/button';
import { assignments, course, rubricByAssignment } from '../data';
import GamificationPanel from '../components/GamificationPanel.astro';
import KaplayMissionGame from '../components/KaplayMissionGame';

const meta = `${assignments.length} assignments · ${course.term}`;
---

<BaseLayout title={`Assignments — ${course.code}: ${course.title}`} description="Coding assignments, projects, and submission progress.">
  <article class="max-w-3xl">
    <PageHeader title="Assignments" meta={meta} />

    <Section id="overview-heading" title="Overview">
      <div class="border border-border overflow-hidden">
        <Table>
          <TableCaption class="sr-only">Assignment overview</TableCaption>
          <TableHeader>
            <TableRow class="bg-muted/50">
              <TableHead scope="col" class="w-16">#</TableHead>
              <TableHead scope="col">Assignment</TableHead>
              <TableHead scope="col" class="text-right w-20">Weight</TableHead>
              <TableHead scope="col" class="w-32">Due</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {assignments.map((a) => (
              <TableRow>
                <TableCell class="font-medium">{a.id}</TableCell>
                <TableCell class="font-medium">{a.title}</TableCell>
                <TableCell class="text-right">{a.weight}%</TableCell>
                <TableCell>{a.due}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>
    </Section>

    <GamificationPanel />

    <KaplayMissionGame client:visible />

    <Section id="details-heading" title="Details">
      <div class="space-y-8">
        {assignments.map((a) => (
          <section id={`assignment-${a.id}`} aria-label={a.title}>
            <h3 class="text-lg font-semibold mb-2">{a.id}. {a.title}</h3>
            <dl class="grid sm:grid-cols-2 gap-x-6 gap-y-1 text-sm">
              <dt class="text-muted-foreground">Due date</dt>
              <dd class="font-medium">{a.due}</dd>
              <dt class="text-muted-foreground">Weight</dt>
              <dd class="font-medium">{a.weight}% of final grade</dd>
            </dl>
            <p class="mt-5 leading-relaxed">{a.description}</p>
            <p class="mt-5 font-medium">Requirements:</p>
            <ul class="list-disc pl-5 space-y-1 text-muted-foreground">
              {a.requirements.map((req) => (
                <li>{req}</li>
              ))}
            </ul>
            <div class="mt-6">
              {(() => {
                const rubric = rubricByAssignment[a.id];
                if (!rubric) return null;
                return (
                  <Card>
                    <CardHeader>
                      <div class="flex items-center justify-between">
                        <CardTitle class="text-sm font-semibold">Grading Rubric</CardTitle>
                        {rubric.pdfPath && (
                          <Button variant="outline" size="sm" href={`/materials/${rubric.pdfPath}/`} target="_blank" rel="noopener" class="h-7 px-2 text-xs">
                            View PDF
                          </Button>
                        )}
                      </div>
                    </CardHeader>
                    <CardContent>
                      <div class="space-y-3">
                        {rubric.criteria.map((criterion) => (
                          <div class="flex justify-between items-start gap-4 text-xs">
                            <div class="flex-1">
                              <span class="font-medium text-foreground">{criterion.name}</span>
                              <p class="text-muted-foreground leading-tight">{criterion.description}</p>
                            </div>
                            <span class="font-mono font-medium text-foreground shrink-0">{criterion.weight}%</span>
                          </div>
                        ))}
                      </div>
                    </CardContent>
                  </Card>
                );
              })()}
            </div>
            </section>
        ))}
      </div>
    </Section>
  </article>
</BaseLayout>
