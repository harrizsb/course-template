---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemTitle } from '@/components/starwind/item';
import { assignments, course } from '../data';

const meta = `${assignments.length} assignments · ${course.term}`;
---

<BaseLayout title={`Assignments — ${course.code}: ${course.title}`} description="Coding assignments, practice games, and rubric score capture.">
  <article class="max-w-3xl">
    <PageHeader title="Assignments" meta={meta} />
    <p class="mt-4 text-sm text-muted-foreground">Choose an assignment to review its brief, requirements, rubric, and practice game.</p>

    <ItemGroup class="mt-10 gap-2" aria-label="Assignments">
      {assignments.map((assignment) => (
        <Item as="a" role="listitem" href={`/assignments/${assignment.id}/`} variant="outline" size="sm">
          <ItemContent>
            <ItemTitle>{assignment.id}. {assignment.title}</ItemTitle>
            <ItemDescription>{assignment.kaplay.title} · {assignment.kaplay.description}</ItemDescription>
          </ItemContent>
          <ItemActions class="flex-col items-end gap-1 text-xs text-muted-foreground sm:flex-row sm:gap-3">
            <span>Due {assignment.due}</span>
            <span>{assignment.weight}%</span>
            <span class="font-medium text-foreground">Open assignment</span>
          </ItemActions>
        </Item>
      ))}
    </ItemGroup>
  </article>
</BaseLayout>
