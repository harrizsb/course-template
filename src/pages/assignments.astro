---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { Table, TableBody, TableCaption, TableCell, TableHead, TableHeader, TableRow } from '@/components/starwind/table';
import { Accordion, AccordionContent, AccordionItem, AccordionTrigger } from '@/components/starwind/accordion';
import { Badge } from '@/components/starwind/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import { Button } from '@/components/starwind/button';
import { assignments, course, rubricByAssignment } from '../data';
import GamificationPanel from '../components/GamificationPanel.astro';
import AssignmentGame from '../components/AssignmentGame';

const meta = `${assignments.length} assignments · ${course.term}`;
---

<BaseLayout title={`Assignments — ${course.code}: ${course.title}`} description="Coding assignments, practice games, and rubric score capture.">
  <article class="max-w-3xl">
    <PageHeader title="Assignments" meta={meta} />
    <p class="mt-4 text-sm text-muted-foreground">Use one assignment at a time. Open a section for its brief, game, rubric, and score capture.</p>

    <Section id="overview-heading" title="Overview">
      <div class="border border-border overflow-hidden">
        <Table>
          <TableCaption class="sr-only">Assignment overview</TableCaption>
          <TableHeader>
            <TableRow class="bg-muted/50">
              <TableHead scope="col" class="w-16">#</TableHead>
              <TableHead scope="col">Assignment</TableHead>
              <TableHead scope="col" class="text-right w-20">Weight</TableHead>
              <TableHead scope="col" class="w-32">Due</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {assignments.map((a) => (
              <TableRow>
                <TableCell class="font-medium">{a.id}</TableCell>
                <TableCell class="font-medium">
                  <a href={`#assignment-${a.id}`} class="text-link underline underline-offset-2 hover:text-primary">{a.title}</a>
                  <span class="block text-xs text-muted-foreground">{a.kaplay.title}</span>
                </TableCell>
                <TableCell class="text-right">{a.weight}%</TableCell>
                <TableCell>{a.due}</TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
      </div>
    </Section>

    <Section id="details-heading" title="Details">
      <Accordion type="single" collapsible defaultValue="assignment-1">
        {assignments.map((a) => {
          const rubric = rubricByAssignment[a.id];
          return (
            <AccordionItem value={`assignment-${a.id}`} id={`assignment-${a.id}`}>
              <AccordionTrigger>
                <span class="flex min-w-0 flex-1 items-center justify-between gap-3 pr-3">
                  <span class="truncate font-medium">{a.id}. {a.title}</span>
                  <span class="shrink-0 text-xs text-muted-foreground">{a.due} · {a.weight}%</span>
                </span>
              </AccordionTrigger>
              <AccordionContent>
                <div class="space-y-6">
                  <div class="space-y-2">
                    <p class="text-sm leading-relaxed">{a.description}</p>
                    <ul class="list-disc pl-5 space-y-1 text-sm text-muted-foreground">
                      {a.requirements.map((req) => <li>{req}</li>)}
                    </ul>
                  </div>
                  <Card size="sm">
                    <CardHeader>
                      <div class="flex items-center justify-between gap-3">
                        <CardTitle class="text-sm">Rubric checkpoints</CardTitle>
                        {rubric.pdfPath && <Button variant="outline" size="sm" href={`/materials/${rubric.pdfPath}/`} target="_blank" rel="noopener" class="h-7 px-2 text-xs">View PDF</Button>}
                      </div>
                      <p class="text-xs text-muted-foreground">Each indicator is scored High, Middle, or Lower in the game.</p>
                    </CardHeader>
                    <CardContent>
                      <div class="space-y-3">
                        {rubric.criteria.map((criterion) => (
                          <div class="flex items-start justify-between gap-3 text-xs">
                            <div><span class="font-medium">{criterion.name}</span><p class="text-muted-foreground">{criterion.description}</p></div>
                            <Badge variant="outline" class="shrink-0">{criterion.weight}%</Badge>
                          </div>
                        ))}
                      </div>
                    </CardContent>
                  </Card>
                  <AssignmentGame assignmentId={a.id} client:visible />
                </div>
              </AccordionContent>
            </AccordionItem>
          );
        })}
      </Accordion>
    </Section>

    <div class="mt-10"><GamificationPanel /></div>
  </article>
</BaseLayout>
