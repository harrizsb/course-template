---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { Item, ItemActions, ItemContent, ItemDescription, ItemGroup, ItemTitle } from '@/components/starwind/item';
import { Badge } from '@/components/starwind/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/starwind/card';
import { Button } from '@/components/starwind/button';
import { assignments, course, rubricByAssignment } from '../data';
import AssignmentGame from '../components/AssignmentGame';

const meta = `${assignments.length} assignments · ${course.term}`;
---

<BaseLayout title={`Assignments — ${course.code}: ${course.title}`} description="Coding assignments, practice games, and rubric score capture.">
  <article class="max-w-3xl">
    <PageHeader title="Assignments" meta={meta} />
    <p class="mt-4 text-sm text-muted-foreground">Use one assignment at a time. Pick an assignment to jump to its brief, game, rubric, and score capture.</p>

    <Section id="assignments-heading" title="Assignments">
      <ItemGroup class="gap-2">
        {assignments.map((a) => (
          <Item as="a" role="listitem" href={`#assignment-${a.id}`} variant="outline" size="sm">
            <ItemContent>
              <ItemTitle>{a.id}. {a.title}</ItemTitle>
              <ItemDescription>{a.kaplay.title}</ItemDescription>
            </ItemContent>
            <ItemActions class="text-xs text-muted-foreground">{a.due} · {a.weight}%</ItemActions>
          </Item>
        ))}
      </ItemGroup>
    </Section>

    {assignments.map((a) => {
      const rubric = rubricByAssignment[a.id];
      return (
        <Section id={`assignment-${a.id}`} title={`${a.id}. ${a.title}`}>
          <p class="text-xs text-muted-foreground">Due {a.due} · Weight {a.weight}%</p>
          <div class="mt-4 space-y-6">
            <div class="space-y-2">
              <p class="text-sm leading-relaxed">{a.description}</p>
              <ul class="list-disc pl-5 space-y-1 text-sm text-muted-foreground">
                {a.requirements.map((req) => <li>{req}</li>)}
              </ul>
            </div>
            <Card size="sm">
              <CardHeader>
                <div class="flex items-center justify-between gap-3">
                  <CardTitle class="text-sm">Rubric checkpoints</CardTitle>
                  {rubric.pdfPath && <Button variant="outline" size="sm" href={`/materials/${rubric.pdfPath}/`} target="_blank" rel="noopener" class="h-7 px-2 text-xs">View PDF</Button>}
                </div>
                <p class="text-xs text-muted-foreground">Each indicator is scored High, Middle, or Lower in the game.</p>
              </CardHeader>
              <CardContent>
                <div class="space-y-3">
                  {rubric.criteria.map((criterion) => (
                    <div class="flex items-start justify-between gap-3 text-xs">
                      <div><span class="font-medium">{criterion.name}</span><p class="text-muted-foreground">{criterion.description}</p></div>
                      <Badge variant="outline" class="shrink-0">{criterion.weight}%</Badge>
                    </div>
                  ))}
                </div>
              </CardContent>
            </Card>
            <AssignmentGame assignmentId={a.id} client:visible />
          </div>
        </Section>
      );
    })}
  </article>
</BaseLayout>
